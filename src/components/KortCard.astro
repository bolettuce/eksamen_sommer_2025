---
const { title, artist, year, slug, placering } = Astro.props;
const imageUrl = `https://izzrgdiwpkuoqjpmqgtu.supabase.co/storage/v1/object/public/artworks/artwork-images/${slug}/billede1.webp`;
---

<article class="flex flex-col bg-white/95 border border-black/10 rounded-lg shadow-md w-[280px] min-h-[260px] overflow-hidden">
  <img 
    src={imageUrl} 
    alt={`Billede af ${title}`} 
    class="w-full h-[150px] object-cover"
    loading="lazy"
  />
  <div class="p-m flex flex-col gap-1">
    <h3 class="text-body-regular font-medium leading-tight">{title}</h3>
    <p class="text-body-small text-black/70 leading-tight">{artist} / {year}</p>
    <p class="text-body-small text-black/70 leading-tight">{placering}</p>
    <a href={`/${slug}`} class="inline-flex items-center text-body-small font-semibold text-black mt-1 hover:underline">
      Læs mere →
    </a>
  </div>
</article>
