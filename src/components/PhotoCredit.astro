---
const { class: className = '' } = Astro.props;
const baseClasses = 'absolute bottom-3 right-3 text-[10px] tracking-[0.08em] uppercase text-white/80 bg-black/30 backdrop-blur-sm rounded-full px-3 py-1 pointer-events-none';
---

<span class={`${baseClasses} ${className}`.trim()}>
  Foto: Torben Eskerod
</span>
